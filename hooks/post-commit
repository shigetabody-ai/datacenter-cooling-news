#!/bin/sh
# Auto-push every local commit to GitHub immediately.
# Prevents the "committed locally but never pushed" failure mode that
# broke the Excel export pipeline (reports sat in local git history only).

repo_root=$(git rev-parse --show-toplevel)
log_file="$repo_root/logs/git_autopush.log"
mkdir -p "$repo_root/logs"
branch=$(git rev-parse --abbrev-ref HEAD)
ts=$(date '+%Y-%m-%d %H:%M:%S')

{
  if git push origin "$branch" 2>&1; then
    echo "[$ts] push ok ($branch)"
  else
    echo "[$ts] push rejected, fetching + merging origin/$branch"
    git fetch origin "$branch" 2>&1
    if git merge "origin/$branch" --no-edit -m "Auto-merge origin/$branch (post-commit hook)" 2>&1; then
      if git push origin "$branch" 2>&1; then
        echo "[$ts] merge+push ok ($branch)"
      else
        echo "[$ts] ERROR: push still failing after merge - manual action required"
      fi
    else
      echo "[$ts] ERROR: merge conflict - manual resolution required"
      git merge --abort 2>&1
    fi
  fi
} >> "$log_file" 2>&1

exit 0
